# Artefactos de Netlify
.netlify/

# Originales de imagen: pesan mucho y no se publican directamente.
# Las versiones para web se generan con _gen_assets.py.
assets-src/
Imagenes/

# Material del curso: se versiona el material escrito y las imágenes de apoyo,
# pero los vídeos no entran al repositorio (pesan decenas de MB).
Curso/*.mp4

# Capturas de verificación visual
.shots/
_shot_*.png
_shot_*.html
_probe.html
_mv.jpg

# Python
__pycache__/
*.py[cod]

# _gen_og.py escribe en la raiz por error; las versiones correctas estan
# en assets/ y las genera _gen_brand.py.
og-image.png
apple-touch-icon.png

# Sistema
.DS_Store
Thumbs.db
.env
.env.*

# Editores
.vscode/
.idea/
*.swp
# Recursos multimedia pesados no necesarios en el repo
Curso/*.mp4
Curso/*.jpg
curso/*.mp4
curso/*.jpg
curso/IMAGEN*
